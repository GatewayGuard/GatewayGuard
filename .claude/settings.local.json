{
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "PowerShell(Get-ChildItem *)",
      "PowerShell(Get-Content *)",
      "PowerShell(Get-Item *)",
      "PowerShell(Test-Path *)",
      "PowerShell(Select-String *)",
      "PowerShell(winget install *)",
      "Bash(py --version)",
      "Bash(python build_ascii37.py)",
      "Bash(sed -i 's|ascii36-2026-07-27-1655|ascii37-2026-07-28-1330|' measure.py)",
      "Bash(python measure.py)",
      "Bash(python final_check.py)",
      "Bash(python patch_header_count.py)",
      "Bash(awk '{print $1}')",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Read(//c/GatewayGuard/Logs/**)",
      "Bash(python -c ' *)",
      "PowerShell(Get-Date *)",
      "WebSearch"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"${CLAUDE_PROJECT_DIR}/.claude/check-ps1-integrity.ps1\"",
            "timeout": 60,
            "statusMessage": "Checking .ps1 file integrity..."
          }
        ]
      }
    ]
  }
}
