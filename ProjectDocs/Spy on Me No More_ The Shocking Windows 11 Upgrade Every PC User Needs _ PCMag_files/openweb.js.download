document.addEventListener('alpine:init', () => {
    Alpine.data('openwebLoader', ({
        spotId,
        postUrl,
        postId,
        modules,
        showTopicTracker,
        authors,
        keywords,
    }) => ({
        init() {
            if (window.openwebInitialized) return;
            window.openwebInitialized = true;

            // Insert module containers so the OpenWeb launcher can find them.
            // The launcher script itself is loaded directly in the <head> as async
            // and handles its own lazy loading (renders when the section is near viewport).
            this.insertModules();
        },

        insertModules() {
            const commentsSection = document.getElementById('comments');

            if (showTopicTracker) {
                const topicTrackerDiv = document.createElement('div');
                topicTrackerDiv.id = 'topic-tracker';
                topicTrackerDiv.dataset.spotimModule = 'topic-tracker';
                topicTrackerDiv.dataset.postUrl = postUrl;
                topicTrackerDiv.dataset.postId = postId;
                topicTrackerDiv.dataset.spotId = spotId;
                if (authors) topicTrackerDiv.dataset.authors = authors;
                if (keywords) topicTrackerDiv.dataset.keywords = keywords;
                commentsSection.append(topicTrackerDiv);
            }

            if (modules.includes('conversation')) {
                const conversationDiv = document.createElement('div');
                conversationDiv.dataset.spotimModule = 'conversation';
                conversationDiv.dataset.postUrl = postUrl;
                conversationDiv.dataset.postId = postId;
                commentsSection.append(conversationDiv);
            }

            if (modules.includes('pitc')) {
                const pitcDiv = document.createElement('div');
                pitcDiv.dataset.spotimModule = 'pitc';
                commentsSection.append(pitcDiv);
            }
        },
    }));
});
