document.addEventListener('alpine:init', () => {
    Alpine.data('tableOfContents', links => ({
        links: links?.map(link => ({ text: _unescape(link.text), anchor: link.anchor })) || [],
        open: false,
        selection: { text: 'Table of Contents', anchor: location.hash?.replace('#', '') ?? null },
        leftRailTOCHeightStyle: '',
        select(link, isLeftRailTOC = false) {
            this.selection = link;
            if (!isLeftRailTOC) this.open = false;
            const anchor = this.selection.anchor;

            if (anchor === '' || anchor === null) {
                return;
            }

            location.hash = anchor;
            let scrollHeight = window.scrollY || window.pageYOffset;
            const offset = (anchor === 'compare-our-picks' ? 125 : 25) + (isLeftRailTOC ? 0 : 75);

            window.scrollTo({ top: document.getElementById(anchor).getBoundingClientRect().top + scrollHeight - 200, behavior: 'auto' })
            // Timeout so ads/embeds load before anchoring to content
            setTimeout(() => {
                scrollHeight = window.scrollY || window.pageYOffset;
                window.scrollTo({ top: document.getElementById(anchor).getBoundingClientRect().top + scrollHeight - offset, behavior: 'smooth' });
            }, 500);
        },
        isValidLink: anchor => !!document.getElementById(anchor),
        calculateLeftRailTOCHeight() {
            if (!this.$refs.leftRailTOC) return 'height: 0px';

            const cellCount = this.open ? 10 : 6
            const childNodes = [...this.$refs.leftRailTOC.children].filter(child => child.offsetHeight).slice(0, this.links.length < cellCount ? this.links.length : cellCount)
            const height = Math.round(childNodes.reduce((sum, child) => sum + child.offsetHeight, 0))
            return `height: ${height}px`;
        },
        init() {
            if (this.links?.length > 3) {
                const callback = entries => entries.forEach(entry => entry.isIntersecting ? this.selection = this.links.find(link => link.anchor === entry.target.id) : null);
                const observer = new IntersectionObserver(callback, {
                    rootMargin: '-35px 0px -' + (window.innerHeight - 175) + 'px 0px',
                    threshold: 0
                })

                this.links.forEach(link => {
                    const linkNode = document.getElementById(link.anchor);
                    linkNode !== null && observer.observe(linkNode);
                })

                this.$nextTick(() => {
                    if (location.hash) {
                        history.scrollRestoration = 'manual'
                        this.select(this.selection)
                    }
                    this.leftRailTOCHeightStyle = this.calculateLeftRailTOCHeight()
                })

                this.$watch('open', () => this.leftRailTOCHeightStyle = this.calculateLeftRailTOCHeight())
            }
        }
    }))
})